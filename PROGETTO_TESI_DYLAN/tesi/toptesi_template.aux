\@writefile{lof}{\contentsline {figure}{\numberline {3.11}{\ignorespaces Proprietà 4 -- Matrice di correlazione riordinata per clustering gerarchico: blocchi settoriali densi e riconoscibili nella matrice reale contro un campo omogeneo e amorfo nel benchmark RMT, ottenuto applicando lo stesso algoritmo di ordinamento.}}{33}{figure.3.11}\protected@file@percent }
\newlabel{fig:rmt_heatmap}{{3.11}{33}{Proprietà 4 -- Matrice di correlazione riordinata per clustering gerarchico: blocchi settoriali densi e riconoscibili nella matrice reale contro un campo omogeneo e amorfo nel benchmark RMT, ottenuto applicando lo stesso algoritmo di ordinamento}{figure.3.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.12}{\ignorespaces Proprietà 4 -- Dendrogramma del clustering gerarchico con le foglie colorate per settore GICS: nella matrice reale i settori formano cluster compatti che si fondono a bassa distanza, mentre nel benchmark RMT le fusioni sono tutte schiacciate ad alta distanza e i colori settoriali appaiono dispersi, senza alcun cluster.}}{34}{figure.3.12}\protected@file@percent }
\newlabel{fig:rmt_dendrogram}{{3.12}{34}{Proprietà 4 -- Dendrogramma del clustering gerarchico con le foglie colorate per settore GICS: nella matrice reale i settori formano cluster compatti che si fondono a bassa distanza, mentre nel benchmark RMT le fusioni sono tutte schiacciate ad alta distanza e i colori settoriali appaiono dispersi, senza alcun cluster}{figure.3.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.13}{\ignorespaces Proprietà 5 -- Distribuzione di grado dell'MST in scala log-log: la matrice reale raggiunge un grado massimo di $14$ su un intervallo esteso, mentre il benchmark RMT si esaurisce entro il grado $6$, senza alcun nodo \emph  {hub}. La retta tratteggiata sul pannello reale è l'interpolazione lineare in scala log-log (legge di potenza), con pendenza $\approx -2.21$ e $R^2 \approx 0.98$, coerente con una struttura scale-free; il pannello del benchmark RMT non ammette interpolazione analoga.}}{35}{figure.3.13}\protected@file@percent }
\newlabel{fig:rmt_mst_degree}{{3.13}{35}{Proprietà 5 -- Distribuzione di grado dell'MST in scala log-log: la matrice reale raggiunge un grado massimo di $14$ su un intervallo esteso, mentre il benchmark RMT si esaurisce entro il grado $6$, senza alcun nodo \emph {hub}. La retta tratteggiata sul pannello reale è l'interpolazione lineare in scala log-log (legge di potenza), con pendenza $\approx -2.21$ e $R^2 \approx 0.98$, coerente con una struttura scale-free; il pannello del benchmark RMT non ammette interpolazione analoga}{figure.3.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.14}{\ignorespaces Proprietà 5 -- Visualizzazione topologica del Minimum Spanning Tree, con entrambi i pannelli colorati per settore GICS (dimensione = grado del nodo): nella matrice reale i settori si aggregano in \emph  {hub} e rami omogenei, mentre nel benchmark RMT gli stessi colori settoriali appaiono dispersi in modo casuale, senza alcun cluster.}}{35}{figure.3.14}\protected@file@percent }
\newlabel{fig:rmt_mst_graph}{{3.14}{35}{Proprietà 5 -- Visualizzazione topologica del Minimum Spanning Tree, con entrambi i pannelli colorati per settore GICS (dimensione = grado del nodo): nella matrice reale i settori si aggregano in \emph {hub} e rami omogenei, mentre nel benchmark RMT gli stessi colori settoriali appaiono dispersi in modo casuale, senza alcun cluster}{figure.3.14}{}}
