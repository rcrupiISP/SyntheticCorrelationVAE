\@writefile{lot}{\contentsline {table}{\numberline {7.1}{\ignorespaces Errori di ricostruzione sul \emph  {Test Set}, dominio Cholesky, al variare della dimensione latente $K$: MSE, MAE e norma di Frobenius riuniti in un unico prospetto. I valori sono media $\pm $ deviazione standard sulle $42$ matrici del \emph  {Test Set}; la freccia accanto a ciascuna metrica indica la direzione di miglioramento e il grassetto segnala il valore migliore di ogni colonna, senza che ciò implichi significatività statistica là dove lo scarto è piccolo rispetto alla dispersione (come accade a $K=100$, dove i tre modelli sono di fatto equivalenti). Sulla griglia condivisa $K\in \{3,10,20,100\}$ il VAE compare solo a $K=20$, perché le sue run sono state condotte a $K\in \{10,20,30\}$ (Sezione~\ref {subsec:vae_vs_k}, Tabella~\ref {tab:vae_vs_k_test}).}}{62}{table.7.1}\protected@file@percent }
\newlabel{tab:err_test_cholesky}{{7.1}{62}{Errori di ricostruzione sul \emph {Test Set}, dominio Cholesky, al variare della dimensione latente $K$: MSE, MAE e norma di Frobenius riuniti in un unico prospetto. I valori sono media $\pm $ deviazione standard sulle $42$ matrici del \emph {Test Set}; la freccia accanto a ciascuna metrica indica la direzione di miglioramento e il grassetto segnala il valore migliore di ogni colonna, senza che ciò implichi significatività statistica là dove lo scarto è piccolo rispetto alla dispersione (come accade a $K=100$, dove i tre modelli sono di fatto equivalenti). Sulla griglia condivisa $K\in \{3,10,20,100\}$ il VAE compare solo a $K=20$, perché le sue run sono state condotte a $K\in \{10,20,30\}$ (Sezione~\ref {subsec:vae_vs_k}, Tabella~\ref {tab:vae_vs_k_test})}{table.7.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces MSE di ricostruzione sul \emph  {Test Set} (dominio Cholesky) in funzione della dimensione latente $K$, per i quattro modelli confrontati (scala logaritmica).}}{62}{figure.7.1}\protected@file@percent }
\newlabel{fig:mse_vs_k}{{7.1}{62}{MSE di ricostruzione sul \emph {Test Set} (dominio Cholesky) in funzione della dimensione latente $K$, per i quattro modelli confrontati (scala logaritmica)}{figure.7.1}{}}
