\@writefile{lot}{\contentsline {table}{\numberline {7.2}{\ignorespaces Metriche topologiche di similarità fra il Minimum Spanning Tree della matrice originale e quello della matrice ricostruita, dominio Cholesky, \emph  {Test Set}, al variare di $K$: tutte e cinque le metriche riunite in un unico prospetto. I valori sono media $\pm $ deviazione standard sulle $42$ matrici del \emph  {Test Set}; la freccia accanto a ciascuna metrica indica la direzione di miglioramento e il grassetto segnala il valore migliore di ogni colonna, senza che ciò implichi significatività statistica là dove lo scarto è piccolo rispetto alla dispersione. Il VAE compare solo a $K=20$ perché è l'unico valore della griglia condivisa a cui è stato addestrato (Sezione~\ref {subsec:vae_vs_k}).}}{66}{table.7.2}\protected@file@percent }
\newlabel{tab:mst_test_cholesky}{{7.2}{66}{Metriche topologiche di similarità fra il Minimum Spanning Tree della matrice originale e quello della matrice ricostruita, dominio Cholesky, \emph {Test Set}, al variare di $K$: tutte e cinque le metriche riunite in un unico prospetto. I valori sono media $\pm $ deviazione standard sulle $42$ matrici del \emph {Test Set}; la freccia accanto a ciascuna metrica indica la direzione di miglioramento e il grassetto segnala il valore migliore di ogni colonna, senza che ciò implichi significatività statistica là dove lo scarto è piccolo rispetto alla dispersione. Il VAE compare solo a $K=20$ perché è l'unico valore della griglia condivisa a cui è stato addestrato (Sezione~\ref {subsec:vae_vs_k})}{table.7.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces Percentuale di archi in comune tra l'MST della matrice originale e quello della matrice ricostruita, dominio Cholesky, \emph  {Test Set}, in funzione di $K$. Valori più grandi corrispondono a una ricostruzione migliore ($\uparrow $).}}{67}{figure.7.4}\protected@file@percent }
\newlabel{fig:mst_edge_overlap_vs_k}{{7.4}{67}{Percentuale di archi in comune tra l'MST della matrice originale e quello della matrice ricostruita, dominio Cholesky, \emph {Test Set}, in funzione di $K$. Valori più grandi corrispondono a una ricostruzione migliore ($\uparrow $)}{figure.7.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces Indice di Jaccard fra l'insieme degli archi dell'MST della matrice originale e quello della matrice ricostruita, dominio Cholesky, \emph  {Test Set}, in funzione di $K$. Valori più grandi corrispondono a una ricostruzione migliore ($\uparrow $).}}{67}{figure.7.5}\protected@file@percent }
\newlabel{fig:mst_edge_jaccard_vs_k}{{7.5}{67}{Indice di Jaccard fra l'insieme degli archi dell'MST della matrice originale e quello della matrice ricostruita, dominio Cholesky, \emph {Test Set}, in funzione di $K$. Valori più grandi corrispondono a una ricostruzione migliore ($\uparrow $)}{figure.7.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces Percentuale di sovrapposizione fra i dieci nodi a più alta \emph  {betweenness centrality} dell'MST originale e quelli dell'MST ricostruito, dominio Cholesky, \emph  {Test Set}, in funzione di $K$. Valori più grandi corrispondono a una ricostruzione migliore ($\uparrow $).}}{68}{figure.7.6}\protected@file@percent }
\newlabel{fig:mst_betweenness_vs_k}{{7.6}{68}{Percentuale di sovrapposizione fra i dieci nodi a più alta \emph {betweenness centrality} dell'MST originale e quelli dell'MST ricostruito, dominio Cholesky, \emph {Test Set}, in funzione di $K$. Valori più grandi corrispondono a una ricostruzione migliore ($\uparrow $)}{figure.7.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.7}{\ignorespaces Scarto assoluto fra la lunghezza media dei cammini dell'MST originale e quella dell'MST ricostruito, versione pesata sulle distanze, dominio Cholesky, \emph  {Test Set}, in funzione di $K$. Trattandosi di uno scarto rispetto all'originale, qui il verso del confronto si inverte: valori più piccoli corrispondono a una ricostruzione migliore ($\downarrow $).}}{68}{figure.7.7}\protected@file@percent }
\newlabel{fig:mst_avg_path_len_vs_k}{{7.7}{68}{Scarto assoluto fra la lunghezza media dei cammini dell'MST originale e quella dell'MST ricostruito, versione pesata sulle distanze, dominio Cholesky, \emph {Test Set}, in funzione di $K$. Trattandosi di uno scarto rispetto all'originale, qui il verso del confronto si inverte: valori più piccoli corrispondono a una ricostruzione migliore ($\downarrow $)}{figure.7.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.8}{\ignorespaces Scarto assoluto fra la lunghezza media dei cammini dell'MST originale e quella dell'MST ricostruito, versione non pesata (conteggio degli archi), dominio Cholesky, \emph  {Test Set}, in funzione di $K$. Come nella Figura~\ref {fig:mst_avg_path_len_vs_k}, valori più piccoli corrispondono a una ricostruzione migliore ($\downarrow $).}}{69}{figure.7.8}\protected@file@percent }
